local introSoundEnabled = false
local introSoundInstance = nil
-- Declare persisted visual states before loading M10RU.json.
local animEnabled = false
local backgroundEnabled = false
local backgroundIndex = 0
if isfile and isfile("M10RU.json") then
    local ok2, d2 = pcall(function() return HS:JSONDecode(readfile("M10RU.json")) end)
    if ok2 and type(d2)=="table" then
        if type(d2.animEnabled)=="boolean" then animEnabled=d2.animEnabled end
