local function safeWriteJson(path, value)
    if type(writefile) ~= "function" then return false end
    local ok, encoded = pcall(function() return HS:JSONEncode(value) end)
    if not ok then return false end
    return pcall(function() writefile(path, encoded) end)
end

local function safeReadJson(path)
    if type(isfile) ~= "function" or not isfile(path) or type(readfile) ~= "function" then return nil end
    local ok, value = pcall(function() return HS:JSONDecode(readfile(path)) end)
    return ok and type(value) == "table" and value or nil
end

