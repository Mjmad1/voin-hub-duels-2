-- WHALEHUB LINEAR VELOCITY ENGINE (UNDETECTED SPEED)
-- ============================================================
local whaleLV = nil          -- LinearVelocity object
local whaleAttach = nil      -- Attachment object

local function whaleSetupLV(hrp)
    -- تنظيف القديم
    if whaleLV and whaleLV.Parent then whaleLV:Destroy() end
    if whaleAttach and whaleAttach.Parent then whaleAttach:Destroy() end

    whaleAttach = Instance.new("Attachment")
    whaleAttach.Name = "WhaleBoostAtt"
    whaleAttach.Parent = hrp

    whaleLV = Instance.new("LinearVelocity")
    whaleLV.Name = "WhaleBoostLV"
    whaleLV.Attachment0 = whaleAttach
    -- وضع الطائرة (Plane) يمنع أي قوة على محور Y نهائياً
    whaleLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
    whaleLV.PrimaryTangentAxis = Vector3.new(1, 0, 0)  -- X
    whaleLV.SecondaryTangentAxis = Vector3.new(0, 0, 1) -- Z
    whaleLV.MaxForce = math.huge
    whaleLV.PlaneVelocity = Vector2.zero
    whaleLV.RelativeTo = Enum.ActuatorRelativeTo.World
    whaleLV.Parent = hrp
end

local function whaleApplySpeed(moveDir, speed)
    -- التأكد من وجود المحرك
    if not whaleLV or not whaleLV.Parent then
        local char = LP.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then whaleSetupLV(hrp) end
        end
    end
    if not whaleLV then return end

    -- تطبيق السرعة بناءً على اتجاه الحركة (X, Z فقط)
    if moveDir and moveDir.Magnitude > 0.1 then
        local flat = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
        whaleLV.PlaneVelocity = Vector2.new(flat.X * speed, flat.Z * speed)
    else
        whaleLV.PlaneVelocity = Vector2.zero
    end
end

local function whaleDestroy()
    if whaleLV then whaleLV:Destroy(); whaleLV = nil end
    if whaleAttach then whaleAttach:Destroy(); whaleAttach = nil end
end

