        instaResetInProgress=false
    end

    if humanoid then
        table.insert(conns,humanoid.Died:Connect(finishResetLock))
    end
    if character then
        table.insert(conns,character.AncestryChanged:Connect(function(_,parent)
            if not parent then finishResetLock() end
        end))
    end

    -- One request is sufficient. The previous loop sent up to 50 requests
    -- before Roblox finished the first reset, causing repeated respawns.
    pcall(function()
        cursedResetRemote:FireServer(CURSED_RESET_GUID,LP,"balloon")
    end)

    -- Failsafe: unlock the button if the game does not emit a death or
