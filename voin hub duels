-- Bat Aimbot (replacement implementation)
-- Uses the attached melee-targeting behavior while reusing this script's
-- existing toggle, speed, respawn, and UI systems.
local batAimAttachment=nil
local batAimLinearVelocity=nil
local batAimAlign=nil
local function getBatForAimbot()
    local char=LP.Character
    if char then
        for _,tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("bat") then return tool end
        end
    end
    local backpack=LP:FindFirstChildOfClass("Backpack")
    if backpack then
        for _,tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find("bat") then return tool end
        end
    end
    return nil
end
startBatAimbot=function()
    autoBatEnabled=true
    selectedAimbotMode="Normal"
    if batAimConnFixed then batAimConnFixed:Disconnect();batAimConnFixed=nil end
    local char=LP.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if root then
        batAimAttachment=Instance.new("Attachment")
        batAimAttachment.Name="M10RUBatAimAttachment"
        batAimAttachment.Parent=root
        batAimLinearVelocity=Instance.new("LinearVelocity")
        batAimLinearVelocity.Name="M10RUBatAimVelocity"
        batAimLinearVelocity.Attachment0=batAimAttachment
        batAimLinearVelocity.MaxForce=1e9
        batAimLinearVelocity.ForceLimitMode=Enum.ForceLimitMode.PerAxis
        batAimLinearVelocity.MaxAxesForce=Vector3.new(1e9,1e9,1e9)
        batAimLinearVelocity.RelativeTo=Enum.ActuatorRelativeTo.World
        batAimLinearVelocity.Enabled=false
        batAimLinearVelocity.Parent=root
        batAimAlign=Instance.new("AlignOrientation")
        batAimAlign.Name="M10RUBatAimAlign"
        batAimAlign.Attachment0=batAimAttachment
        batAimAlign.MaxTorque=math.huge
        batAimAlign.Responsiveness=200
        batAimAlign.Enabled=false
        batAimAlign.Parent=root
    end
    local currentTarget=nil
    batAimConnFixed=RunService.Heartbeat:Connect(function()
        if not autoBatEnabled then return end
        char=LP.Character
        root=char and char:FindFirstChild("HumanoidRootPart")
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health<=0 or isRagdollState(hum) then return end
        if not batAimLinearVelocity or batAimLinearVelocity.Parent~=root then
            stopBatAimbot()
            startBatAimbot()
            return
        end

        if currentTarget and currentTarget.Parent then
            local targetHum=currentTarget.Parent:FindFirstChildOfClass("Humanoid")
            if not targetHum or targetHum.Health<=0 or (currentTarget.Position-root.Position).Magnitude>70 then currentTarget=nil end
        else
            currentTarget=nil
        end
        if not currentTarget then currentTarget=nearestTarget(70) end
        if not currentTarget then
            batAimLinearVelocity.Enabled=false
            batAimAlign.Enabled=false
            hum.AutoRotate=true
            return
        end

        local targetPos=currentTarget.Position + currentTarget.CFrame.LookVector*0.4
        local dir=targetPos-root.Position
        hum.AutoRotate=false
        batAimLinearVelocity.Enabled=true
        local activeSpeed=getBatAimbotSpeed()
        batAimLinearVelocity.VectorVelocity=dir.Magnitude>0.1 and dir.Unit*activeSpeed or Vector3.zero
        local lookDir=Vector3.new(targetPos.X-root.Position.X,0,targetPos.Z-root.Position.Z)
        if lookDir.Magnitude>0.01 then
            batAimAlign.Enabled=true
            batAimAlign.CFrame=CFrame.lookAt(root.Position,root.Position+lookDir)
        end

        local bat=getBatForAimbot()
        if bat then
            if bat.Parent~=char then pcall(function() hum:EquipTool(bat) end) end
            if autoSwingEnabled then pcall(function() bat:Activate() end) end
            local handle=bat:FindFirstChild("Handle")
            if handle and (currentTarget.Position-root.Position).Magnitude<=8 and firetouchinterest then
                for _,part in ipairs(currentTarget.Parent:GetChildren()) do
                    if part:IsA("BasePart") then
                        pcall(function()
                            firetouchinterest(handle,part,0)
                            firetouchinterest(handle,part,1)
                        end)
                    end
                end
            end
        end
    end)
end
stopBatAimbot=function()
    autoBatEnabled=false
    if batAimConnFixed then batAimConnFixed:Disconnect();batAimConnFixed=nil end
    if batAimLinearVelocity then batAimLinearVelocity:Destroy();batAimLinearVelocity=nil end
    if batAimAlign then batAimAlign:Destroy();batAimAlign=nil end
    if batAimAttachment then batAimAttachment:Destroy();batAimAttachment=nil end
    if whaleLV then whaleLV.PlaneVelocity=Vector2.zero end
    local char=LP.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate=true end
end
