-- Carry / Lagger controls
-- Carry / Lagger controls
-- Keep the three related buttons visually synchronized:
-- Lagger Carry ON = Carry ON + Lagger ON + Lagger Carry ON.
local function updateSpeedVisuals()
    if refreshSpeedModeLabel then refreshSpeedModeLabel() end

    -- Lagger Carry has its own visual state. Do NOT light up the
    -- separate Carry/Lagger buttons when Lagger Carry is selected.
    local carryOn = carrySpeedActive == true
    local laggerOn = laggerModeEnabled == true
    local laggerCarryOn = carryOn and laggerOn

    if mobBtnRefs.carrySpeed then
        pcall(function() mobBtnRefs.carrySpeed(carryOn and not laggerCarryOn) end)
    end
    if mobBtnRefs.lagger then
        pcall(function() mobBtnRefs.lagger(laggerOn and not laggerCarryOn) end)
    end
    if mobBtnRefs.laggerCarry then
        pcall(function() mobBtnRefs.laggerCarry(laggerCarryOn) end)
    end
end

-- Speed modes are mutually exclusive:
-- activating one mode automatically disables the other speed modes.
toggleCarryMode=function()
    -- If Lagger Carry is active, both flags are true. Pressing Carry
    -- must switch to Carry-only instead of leaving Lagger Mode active.
    if laggerModeEnabled and carrySpeedActive then
        carrySpeedActive=true
        laggerModeEnabled=false
    elseif carrySpeedActive then
        carrySpeedActive=false
    else
        carrySpeedActive=true
        laggerModeEnabled=false
    end
    updateSpeedVisuals()
end

toggleLaggerMode=function()
    if laggerModeEnabled then
        laggerModeEnabled=false
    else
        laggerModeEnabled=true
        carrySpeedActive=false
    end
    updateSpeedVisuals()
end

toggleLaggerCarryMode=function()
    local enable = not (laggerModeEnabled and carrySpeedActive)

    if enable then
        -- Lagger Carry is the combined speed mode.
        laggerModeEnabled=true
        carrySpeedActive=true
    else
        laggerModeEnabled=false
        carrySpeedActive=false
    end

    updateSpeedVisuals()
end

