end

-- Anti Bypass / tracking mode
startAntiBypass=function()
    antiBypassEnabled=true
    selectedAimbotMode="Anti Bypass"
    if antiBypassConnFixed then antiBypassConnFixed:Disconnect() end
    antiBypassConnFixed=RunService.RenderStepped:Connect(function()
        if not antiBypassEnabled then return end
        local char=LP.Character
        local root=char and char:FindFirstChild("HumanoidRootPart")
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or isRagdollState(hum) then return end

        -- Anti Bypass now uses the same target acquisition as the normal mode.
        local target,targetDist=nearestTarget(180)
        if not target then
            if whaleLV and whaleLV.Parent==root then whaleLV.PlaneVelocity=Vector2.zero end
            return
        end

        local bat=findBat()
        if bat and bat.Parent~=char then pcall(function() hum:EquipTool(bat) end) end

        local flat=Vector3.new(target.Position.X-root.Position.X,0,target.Position.Z-root.Position.Z)
        if flat.Magnitude>0.75 then
            local moveDir=flat.Unit
            local speed=getAntiBypassSpeed()
            hum:Move(moveDir,false)
            whaleApplySpeed(moveDir,speed)
        else
            hum:Move(Vector3.zero,false)
            if whaleLV and whaleLV.Parent==root then whaleLV.PlaneVelocity=Vector2.zero end
        end

        if flat.Magnitude>0.1 then
            root.CFrame=CFrame.lookAt(root.Position,Vector3.new(target.Position.X,root.Position.Y,target.Position.Z))
        end

        if targetDist<=8 and bat and autoSwingEnabled then
            pcall(function() bat:Activate() end)
        end
    end)
end
