cursedInstaReset=function()
    -- Prevent double-clicks and repeated input events from starting a
    -- second reset while the first character reset is still processing.
    if instaResetInProgress then return end

    if not cursedResetRemote then
        for _,desc in ipairs(game:GetDescendants()) do
            if desc:IsA("RemoteEvent") and desc.Name:sub(1,3)=="RE/" then
                cursedResetRemote=desc
