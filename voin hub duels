local espEnabled     = false
local tracersEnabled = false
local espObjects     = {}
local ESP_COLOR      = Color3.fromRGB(255, 255, 255)
local TRACER_COLOR   = Color3.fromRGB(255, 255, 255)

local espGui = Instance.new("ScreenGui")
