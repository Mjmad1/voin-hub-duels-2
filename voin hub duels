local function executeSteal(prompt)
    if isStealing then return end
    if not Steal.Data[prompt] then
        Steal.Data[prompt]={hold={},trigger={},ready=true}
        if getconnections then
            for _,c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do if c.Function then table.insert(Steal.Data[prompt].hold,c.Function) end end
            for _,c in ipairs(getconnections(prompt.Triggered)) do if c.Function then table.insert(Steal.Data[prompt].trigger,c.Function) end end
        end
    end
    local data=Steal.Data[prompt];if not data.ready then return end
    data.ready=false;isStealing=true;stealStartTime=tick()
    task.spawn(function()
        for _,fn in ipairs(data.hold) do task.spawn(fn) end
        task.wait(Steal.HalfHoldMin or 1.3)
        local char=LP.Character;if not char then data.ready=true;isStealing=false;return end
        local root=char:FindFirstChild("HumanoidRootPart");if not root then data.ready=true;isStealing=false;return end
        local promptPart=prompt.Parent;if promptPart and promptPart:IsA("Attachment") then promptPart=promptPart.Parent end
        local inRange=promptPart and (promptPart.Position-root.Position).Magnitude<=(Steal.HalfFireRange or 10) or false
        while true do
            local elapsed=tick()-stealStartTime
            if elapsed>(Steal.HalfHoldMax or 2.6) or not prompt.Parent then break end
            if promptPart and (promptPart.Position-root.Position).Magnitude<=(Steal.HalfFireRange or 10) then
                if not inRange then task.wait(Steal.HalfEntryDelay or 0.3) end
                for _,fn in ipairs(data.trigger) do task.spawn(fn) end
                break
            end
            task.wait()
        end
        task.wait(0.05)
        data.ready=true;isStealing=false
    end)
end
