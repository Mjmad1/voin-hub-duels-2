local function setAntiLagForInstance(obj, enabled)
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
        if enabled then
            if antiLagOriginals[obj] == nil then antiLagOriginals[obj] = obj.Enabled end
            obj.Enabled = false
        else
            if antiLagOriginals[obj] ~= nil then obj.Enabled = antiLagOriginals[obj] end
        end
    elseif obj:IsA("PostEffect") then
        if enabled then
            if antiLagOriginals[obj] == nil then antiLagOriginals[obj] = obj.Enabled end
            obj.Enabled = false
        else
            if antiLagOriginals[obj] ~= nil then obj.Enabled = antiLagOriginals[obj] end
        end
    end
end

enableAntiLag = function()
    antiLagEnabled = true
    if antiLagConn then antiLagConn:Disconnect() end
    local function scan()
        for _, obj in ipairs(workspace:GetDescendants()) do pcall(setAntiLagForInstance, obj, true) end
        for _, obj in ipairs(Lighting:GetChildren()) do pcall(setAntiLagForInstance, obj, true) end
    end
    scan()
    antiLagConn = workspace.DescendantAdded:Connect(function(obj)
        if antiLagEnabled then pcall(setAntiLagForInstance, obj, true) end
    end)
end

disableAntiLag = function()
    antiLagEnabled = false
    if antiLagConn then antiLagConn:Disconnect(); antiLagConn=nil end
    for obj, oldValue in pairs(antiLagOriginals) do
        if obj and obj.Parent then pcall(function() obj.Enabled = oldValue end) end
    end
    antiLagOriginals = {}
end

