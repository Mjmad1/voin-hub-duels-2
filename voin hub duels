RunService.RenderStepped:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    -- تأكد من وجود محرك LinearVelocity على الـ HRP
    if not whaleLV or whaleLV.Parent ~= hrp then
        whaleSetupLV(hrp)
    end

    -- حالة الراجدول: أوقف الحركة فوراً
    if isRagdollState(hum) then
        lastMoveDir = Vector3.new(0, 0, 0)
        if whaleLV then whaleLV.PlaneVelocity = Vector2.zero end
        return
    end

    -- السرعة الطبيعية (غير أوتوماتيكية)
    if not autoBatEnabled and not autoLeftEnabled and not autoRightEnabled then
        local md = hum.MoveDirection
        local spd = getActiveMoveSpeed()

        if md.Magnitude > 0 then
            lastMoveDir = md
            whaleApplySpeed(md, spd)
        elseif antiRagdollEnabled and lastMoveDir.Magnitude > 0 then
            -- مضاد الراجدول: يحافظ على سرعة الحركة الأخيرة
            local anyHeld = false
            for key in pairs(MOVE_KEYS) do
                if UIS:IsKeyDown(key) then anyHeld = true; break end
            end
            if anyHeld then
                whaleApplySpeed(lastMoveDir, spd)
            else
                if whaleLV then whaleLV.PlaneVelocity = Vector2.zero end
            end
        else
            if whaleLV then whaleLV.PlaneVelocity = Vector2.zero end
        end
    else
        -- في حالة تفعيل الأوتوماتيك (Auto Left/Right)، نترك لها التحكم
    end

    -- تحديث عداد السرعة الظاهر على الشاشة
    if speedLabel then
        local currentSpd = 0
        if whaleLV then
            currentSpd = whaleLV.PlaneVelocity.Magnitude
        end
        speedLabel.Text = string.format("%.1f", currentSpd)
    end
end)

