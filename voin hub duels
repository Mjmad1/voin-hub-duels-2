    local lastHit=0
    batTPConnFixed=RunService.Heartbeat:Connect(function()
        if not greenTPEnabled then return end
        local now=tick()
        local char=LP.Character
        local root=char and char:FindFirstChild("HumanoidRootPart")
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health<=0 or isRagdollState(hum) then return end

        local target,targetDist=nearestTarget(120)
        if not target or targetDist>120 then return end

        -- Match the attached TP behavior: place the player just above the
        -- target, then face the target and clear residual velocity.
        local targetPos=target.Position+Vector3.new(0,0.9,0)
        if targetDist>8 then
            if sethiddenproperty then
                pcall(function() sethiddenproperty(root,"PhysicsRepRootPart",target) end)
            end
            root.CFrame=CFrame.new(targetPos)
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
        end
        local camera=workspace.CurrentCamera
        if camera then
            camera.CFrame=CFrame.new(camera.CFrame.Position,target.Position)
        end

        local bat=findBat()
        if bat and bat.Parent~=char then pcall(function() hum:EquipTool(bat) end) end
        if bat and now-lastHit>=0.08 then
            lastHit=now
            pcall(function()
                bat:Activate()
                local ev=bat:FindFirstChildWhichIsA("RemoteEvent")
                if ev then ev:FireServer() end
            end)
        end
    end)
end
