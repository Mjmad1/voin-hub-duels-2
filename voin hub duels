local function applyCurrentAnimPackAfterRespawn(char)
    if not currentAnimPack or currentAnimPack=="" then return end
    local animate=char and char:WaitForChild("Animate",8)
    if not animate then return end
    task.wait(0.15)
    if LP.Character==char then
        applyAnimPack(currentAnimPack)
    end
end

pcall(function()
    if animPackRespawnConn then animPackRespawnConn:Disconnect() end
    animPackRespawnConn=LP.CharacterAdded:Connect(function(char)
        task.spawn(function()
            if currentAnimPack~="" then
                applyCurrentAnimPackAfterRespawn(char)
            end
        end)
    end)
end)

applyAnimPack=function(packName)
	local pack=PACKS[packName]
	if not pack then return false end
	local char=LP.Character;if not char then return false end
	local animate=char:FindFirstChild("Animate");if not animate then return false end
	local hum=char:FindFirstChildOfClass("Humanoid");if hum then pcall(function() for _,t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop(0) end end) end
	local setAnim=function(obj,id) if obj and id then obj.AnimationId="rbxassetid://"..tostring(id) end end
	local walkF=animate:FindFirstChild("walk");if walkF then local wa=walkF:FindFirstChild("WalkAnim");if not wa then wa=Instance.new("Animation");wa.Name="WalkAnim";wa.Parent=walkF end;setAnim(wa,pack.WalkAnim or pack.Walk) end
	local runF=animate:FindFirstChild("run");if runF then local ra=runF:FindFirstChild("RunAnim");if not ra then ra=Instance.new("Animation");ra.Name="RunAnim";ra.Parent=runF end;setAnim(ra,pack.RunAnim or pack.Run) end
	local jumpF=animate:FindFirstChild("jump");if jumpF then local ja=jumpF:FindFirstChild("JumpAnim");if not ja then ja=Instance.new("Animation");ja.Name="JumpAnim";ja.Parent=jumpF end;setAnim(ja,pack.JumpAnim or pack.Jump) end
	local fallF=animate:FindFirstChild("fall");if fallF then local fa=fallF:FindFirstChild("FallAnim");if not fa then fa=Instance.new("Animation");fa.Name="FallAnim";fa.Parent=fallF end;setAnim(fa,pack.FallAnim or pack.Fall) end
	local swF=animate:FindFirstChild("swim");if swF then local sa=swF:FindFirstChild("Swim");if not sa then sa=Instance.new("Animation");sa.Name="Swim";sa.Parent=swF end;setAnim(sa,pack.Swim) end
	local swiF=animate:FindFirstChild("swimidle");if swiF then local sia=swiF:FindFirstChild("SwimIdle");if not sia then sia=Instance.new("Animation");sia.Name="SwimIdle";sia.Parent=swiF end;setAnim(sia,pack.SwimIdle or pack.Swim) end
	local clF=animate:FindFirstChild("climb");if clF then local ca=clF:FindFirstChild("ClimbAnim");if not ca then ca=Instance.new("Animation");ca.Name="ClimbAnim";ca.Parent=clF end;setAnim(ca,pack.ClimbAnim or pack.Climb) end
	local idF=animate:FindFirstChild("idle");if idF then local i1=idF:FindFirstChild("Animation1");if not i1 then i1=Instance.new("Animation");i1.Name="Animation1";i1.Parent=idF end;if pack.Animation1 or pack.Idle then setAnim(i1,pack.Animation1 or (pack.Idle and pack.Idle[1]) or nil) end;local i2=idF:FindFirstChild("Animation2");if not i2 then i2=Instance.new("Animation");i2.Name="Animation2";i2.Parent=idF end;if pack.Animation2 or pack.Idle then setAnim(i2,pack.Animation2 or (pack.Idle and pack.Idle[2]) or pack.Animation1 or (pack.Idle and pack.Idle[1]) or nil) end end
	animate.Disabled=true;task.wait(0.06);animate.Disabled=false
	if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed);task.wait(0.03);hum:ChangeState(Enum.HumanoidStateType.Running) end) end
	currentAnimPack=packName;return true
end

